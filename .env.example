# Production database. Leave unset only for local PGLite development.
DATABASE_URL=

# One-time Chancellor provisioning. Use strong, unique values and rotate the
# setup token after the initial account has been created.
CHANCELLOR_USERNAME=
CHANCELLOR_INITIAL_PASSWORD=
CHANCELLOR_SETUP_TOKEN=

# Shared training-office unlock. Minimum 12 characters.
ADMIN_UNLOCK_PASSWORD=

# URL used by the provisioning script while the app is running.
APP_URL=http://localhost:8080

# Optional platform metadata. Executable extension injection remains off unless
# this is explicitly true.
ENABLE_GROK_EXTENSIONS=false
VITE_PROJECT_ID=
X_CREATOR=
X_CREATOR_ID=

# ---------------------------------------------------------------------------
# Release / preview controls
# ---------------------------------------------------------------------------
# Set to "true" in a release pipeline to make `npm run db:migrate` fail closed
# when DATABASE_URL is absent, instead of silently skipping. NODE_ENV=production
# has the same effect. Leave blank for local work.
MIGRATIONS_REQUIRED=

# Escape hatch that permits the transient in-memory PGLite database outside of
# local dev. `npm run preview` sets this for you. Do NOT set it in a real
# deployment — data would be lost on every restart.
ALLOW_PGLITE_PREVIEW=
